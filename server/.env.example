# Server Configuration (Optional - has defaults)
PORT=3000
NODE_ENV=development

# CORS Configuration (Required for production deployment)
# For local development, defaults to localhost
# For production (Render), set to your frontend URLs (comma-separated)
CORS_ORIGIN=http://localhost:3001

# Example for production:
# CORS_ORIGIN=https://your-frontend.vercel.app,https://your-n8n-instance.app.n8n.cloud
